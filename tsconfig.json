{
    "compilerOptions": {
        "target": "ES2023",
        "lib": [
            "ES2023"
        ],
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "baseUrl": ".",
        "paths": {
            "@/*": [
                "src/*"
            ]
        },
        "types": [
            "node"
        ],

        "strict": true,
        "noUncheckedIndexedAccess": true,
        "noImplicitOverride": true,
        "noFallthroughCasesInSwitch": true,
        "verbatimModuleSyntax": true,
        "isolatedModules": true,
        // Конфиг и тема сайта документации импортируются с явным `.ts`.
        "allowImportingTsExtensions": true,

        // tsc здесь — только тайпчекер: .d.ts и бандл делает tsup.
        "noEmit": true,
        "skipLibCheck": true,
        "esModuleInterop": true,
        "forceConsistentCasingInFileNames": true
    },
    "include": [
        "src",
        // Явные пути вместо каталога `docs/.vitepress`: рядом лежат `dist` и `cache` сайта.
        "docs/.vitepress/*.ts",
        "docs/.vitepress/theme",
        "tsup.config.ts",
        "vitest.config.ts"
    ]
}
